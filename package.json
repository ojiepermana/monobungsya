{
  "name": "@project/root",
  "private": true,
  "packageManager": "bun@1.3.14",
  "imports": {
    "#project/angular-sdk": "./packages/angular-sdk/src/index.ts",
    "#project/config": "./packages/config/src/index.ts",
    "#project/contracts": "./packages/contracts/src/index.ts",
    "#project/database": "./packages/database/src/index.ts",
    "#project/errors": "./packages/errors/src/index.ts",
    "#project/logger": "./packages/logger/src/index.ts",
    "#project/messaging": "./packages/messaging/src/index.ts"
  },
  "scripts": {
    "dev": "bun run --parallel dev:web dev:gateway dev:auth dev:user dev:employee dev:payroll dev:reporting",
    "dev:web": "cd apps/web && ../../node_modules/.bin/ng serve --port 4200 --watch",
    "dev:gateway": "PORT=3000 bun --watch apps/api-gateway/src/main.ts",
    "dev:auth": "PORT=3101 bun --watch apps/services/auth/src/main.ts",
    "dev:user": "PORT=3102 bun --watch apps/services/user/src/main.ts",
    "dev:employee": "PORT=3103 bun --watch apps/services/employee/src/main.ts",
    "dev:payroll": "PORT=3104 bun --watch apps/services/payroll/src/main.ts",
    "dev:reporting": "PORT=3105 bun --watch apps/services/reporting/src/main.ts",
    "test": "bun test apps/api-gateway/src apps/services packages/database/src packages/logger/src packages/contracts/src",
    "test:database": "bun test packages/database/src",
    "test:web": "cd apps/web && ../../node_modules/.bin/ng test --watch=false",
    "lint": "bunx biome check --files-ignore-unknown=true .",
    "format": "prettier --write .",
    "typecheck": "bun run --parallel typecheck:web typecheck:gateway typecheck:auth typecheck:user typecheck:employee typecheck:payroll typecheck:reporting typecheck:database",
    "typecheck:database": "./node_modules/.bin/tsc --noEmit -p packages/database/tsconfig.json",
    "typecheck:web": "cd apps/web && ../../node_modules/.bin/ng build",
    "typecheck:gateway": "tsc --noEmit -p apps/api-gateway/tsconfig.json",
    "typecheck:auth": "tsc --noEmit -p apps/services/auth/tsconfig.json",
    "typecheck:user": "tsc --noEmit -p apps/services/user/tsconfig.json",
    "typecheck:employee": "tsc --noEmit -p apps/services/employee/tsconfig.json",
    "typecheck:payroll": "tsc --noEmit -p apps/services/payroll/tsconfig.json",
    "typecheck:reporting": "tsc --noEmit -p apps/services/reporting/tsconfig.json",
    "build": "bun run build:web && bun run build:gateway && bun run build:auth && bun run build:user && bun run build:employee && bun run build:payroll && bun run build:reporting",
    "build:web": "cd apps/web && ../../node_modules/.bin/ng build",
    "build:gateway": "bun build apps/api-gateway/src/main.ts --outdir dist/gateway --target=bun",
    "build:auth": "bun build apps/services/auth/src/main.ts --outdir dist/service/auth --target=bun",
    "build:user": "bun build apps/services/user/src/main.ts --outdir dist/service/user --target=bun",
    "build:employee": "bun build apps/services/employee/src/main.ts --outdir dist/service/employee --target=bun",
    "build:payroll": "bun build apps/services/payroll/src/main.ts --outdir dist/service/payroll --target=bun",
    "build:reporting": "bun build apps/services/reporting/src/main.ts --outdir dist/service/reporting --target=bun",
    "openapi:generate": "bun run scripts/openapi-generate.ts && bun run openapi:sdk",
    "openapi:sdk": "bunx @hey-api/openapi-ts -i apps/api-gateway/openapi.yaml -o packages/angular-sdk/src/generated",
    "openapi:validate": "bun run scripts/openapi-validate.ts",
    "check:dependencies": "bun run scripts/check-dependencies.ts",
    "db:migrate": "bun run packages/database/src/cli.ts migrate",
    "db:seed": "bun run packages/database/src/cli.ts seed",
    "db:reset": "bun run packages/database/src/cli.ts reset",
    "db:migrate:down": "bun run packages/database/src/cli.ts down",
    "db:seed:reset": "bun run packages/database/src/cli.ts seed-reset"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@elysiajs/cors": "latest",
    "@elysiajs/openapi": "latest",
    "@fontsource/material-symbols-rounded": "5.3.3",
    "@ojiepermana/angular": "^22.1.4",
    "@ojiepermana/angular-theme": "^22.1.4",
    "elysia": "latest",
    "nats": "latest",
    "nodemailer": "^9.0.5",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@biomejs/biome": "latest",
    "@hey-api/openapi-ts": "latest",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "yaml": "latest"
  }
}
