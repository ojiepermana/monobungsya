{
  "name": "@project/root",
  "private": true,
  "packageManager": "bun@1.4.0",
  "imports": {
    "#project/angular-sdk": "./packages/angular-sdk/src/index.ts",
    "#project/config": "./packages/config/src/index.ts",
    "#project/contracts": "./packages/contracts/src/index.ts",
    "#project/database": "./packages/database/src/index.ts",
    "#project/elysia": "./packages/elysia/src/index.ts",
    "#project/errors": "./packages/errors/src/index.ts",
    "#project/logger": "./packages/logger/src/index.ts",
    "#project/messaging": "./packages/messaging/src/index.ts"
  },
  "scripts": {
    "dev": "bun run kill:dev-ports && bun run --parallel dev:web dev:gateway dev:auth dev:user dev:logs",
    "dev:web": "cd apps/web && ../../node_modules/.bin/ng serve --port 4200 --watch",
    "dev:tauri": "bunx tauri dev --config apps/tauri/src/tauri.conf.json",
    "dev:gateway": "PORT=3000 bun --watch apps/gateway/erp/src/main.ts",
    "dev:auth": "PORT=3101 bun --watch apps/services/auth/src/main.ts",
    "dev:user": "PORT=3102 bun --watch apps/services/user/src/main.ts",
    "dev:logs": "PORT=3103 bun --watch apps/services/logs/src/main.ts",
    "dev:mcp": "bun --watch apps/mcp/src/index.ts",
    "kill:dev-ports": "bun run scripts/kill-dev-ports.ts",
    "test": "bun test apps/gateway/erp/src apps/services packages/database/src packages/elysia/src packages/logger/src packages/contracts/src apps/mcp/src/tests",
    "test:mcp": "bun test apps/mcp/src/tests",
    "test:database": "bun test packages/database/src",
    "test:web": "cd apps/web && ../../node_modules/.bin/ng test",
    "lint": "bunx biome check --files-ignore-unknown=true .",
    "format": "bunx biome format --files-ignore-unknown=true --write .",
    "typecheck": "bun run --parallel typecheck:web typecheck:gateway typecheck:auth typecheck:user typecheck:logs typecheck:mcp typecheck:database typecheck:elysia typecheck:tauri",
    "typecheck:database": "./node_modules/.bin/tsc --noEmit -p packages/database/tsconfig.json",
    "typecheck:elysia": "./node_modules/.bin/tsc --noEmit -p packages/elysia/tsconfig.json",
    "typecheck:web": "cd apps/web && ../../node_modules/.bin/ng build",
    "typecheck:gateway": "tsc --noEmit -p apps/gateway/erp/tsconfig.json",
    "typecheck:auth": "tsc --noEmit -p apps/services/auth/tsconfig.json",
    "typecheck:user": "tsc --noEmit -p apps/services/user/tsconfig.json",
    "typecheck:logs": "tsc --noEmit -p apps/services/logs/tsconfig.json",
    "typecheck:mcp": "tsc --noEmit -p apps/mcp/tsconfig.json",
    "typecheck:tauri": "cargo check --manifest-path apps/tauri/src/Cargo.toml",
    "build": "bun run build:web && bun run build:gateway && bun run build:auth && bun run build:user && bun run build:logs && bun run build:mcp",
    "build:web": "cd apps/web && ../../node_modules/.bin/ng build --configuration production",
    "build:gateway": "bun build apps/gateway/erp/src/main.ts --outdir dist/gateway --target=bun",
    "build:auth": "bun build apps/services/auth/src/main.ts --outdir dist/service/auth --target=bun",
    "build:user": "bun build apps/services/user/src/main.ts --outdir dist/service/user --target=bun",
    "build:logs": "bun build apps/services/logs/src/main.ts --outdir dist/service/logs --target=bun",
    "build:mcp": "bun build apps/mcp/src/index.ts --outdir dist/mcp --target=bun",
    "build:tauri": "bunx tauri build --config apps/tauri/src/tauri.conf.json",
    "openapi:generate": "bun run scripts/openapi-generate.ts && bun run openapi:sdk",
    "openapi:sdk": "bunx @hey-api/openapi-ts -i apps/gateway/erp/openapi.yaml -o packages/angular-sdk/src/generated",
    "openapi:validate": "bun run scripts/openapi-validate.ts",
    "check:dependencies": "bun run scripts/check-dependencies.ts",
    "db:migrate": "bun run packages/database/src/cli.ts migrate",
    "db:seed": "bun run packages/database/src/cli.ts seed",
    "db:reset": "bun run packages/database/src/cli.ts reset",
    "db:migrate:down": "bun run packages/database/src/cli.ts down",
    "db:seed:reset": "bun run packages/database/src/cli.ts seed-reset"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@elysiajs/cors": "latest",
    "@elysiajs/openapi": "latest",
    "@fontsource-variable/material-symbols-rounded": "^5.3.3",
    "@modelcontextprotocol/sdk": "latest",
    "@ojiepermana/angular": "^22.1.4",
    "@ojiepermana/angular-theme": "^22.1.4",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "elysia": "latest",
    "nats": "latest",
    "nodemailer": "^9.0.5",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "uuid": "^14.0.2",
    "zod": "latest"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@biomejs/biome": "latest",
    "@hey-api/openapi-ts": "latest",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "jsdom": "^28.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "yaml": "latest"
  }
}
