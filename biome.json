{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dist", "!**/generated", "!**/.angular", "!**/*.ico"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
