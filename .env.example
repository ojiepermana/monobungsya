# Runtime aplikasi: mode proses dan port default gateway.
NODE_ENV=development
PORT=3000

# Database PostgreSQL: koneksi runtime, migrasi, dan pengaturan tooling database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/project
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/project
DATABASE_RESET_ALLOWED=false
DATABASE_LOCK_TIMEOUT_MS=30000
DATABASE_LOCK_POLL_MS=100
DATABASE_TIMEZONE=Asia/Jakarta

# Messaging dan logging: NATS untuk komunikasi antar-service dan level log aplikasi.
NATS_URL=nats://localhost:4222
LOG_LEVEL=info

# Infrastruktur lokal: false menjalankan service tanpa koneksi PostgreSQL dan NATS.
ENABLE_INFRASTRUCTURE=false

# URL publik aplikasi: CORS gateway, URL API, dan URL web browser.
CORS_ORIGIN=http://localhost:4200
PUBLIC_API_URL=http://localhost:3000
WEB_APP_URL=http://localhost:4200

# URL service internal: hanya digunakan gateway untuk meneruskan request.
AUTH_SERVICE_URL=http://localhost:3101
USER_SERVICE_URL=http://localhost:3102

# Email lokal: Herd Pro Mail menangkap email di 127.0.0.1:2525 tanpa mengirimkannya.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USERNAME=monobungsia
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# Authentication dan session: secret internal serta kebijakan cookie browser.
INTERNAL_AUTH_SIGNING_SECRET=
AUTH_SESSION_COOKIE_NAME=project_session
AUTH_COOKIE_SECURE=false
AUTH_CLOCK_SKEW_SECONDS=30
