# Runtime aplikasi: mode proses dan port default gateway.
NODE_ENV=development
PORT=3000

# Database PostgreSQL: koneksi runtime, migrasi, dan pengaturan tooling database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/project
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/project
DATABASE_RESET_ALLOWED=false
DATABASE_LOCK_TIMEOUT_MS=30000
DATABASE_LOCK_POLL_MS=100
DATABASE_TIMEZONE=Asia/Jakarta

# Messaging dan logging: NATS untuk komunikasi antar-service dan level log aplikasi.
NATS_URL=nats://localhost:4222
LOG_LEVEL=info
LOG_DATABASE_URL=postgres://postgres:postgres@localhost:5432/project
BEST_EFFORT_LOGGING_ENABLED=true
LOG_FLUSH_TIMEOUT_MS=5000

# Infrastruktur lokal: false menjalankan service tanpa koneksi PostgreSQL dan NATS.
ENABLE_INFRASTRUCTURE=false
DURABLE_JOBS_ENABLED=false

# Durable jobs: jobs service, worker, scheduler, and retention defaults.
JOBS_SERVICE_PORT=3105
JOBS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/project
NOTIFICATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/project
NOTIFICATION_SERVICE_URL=http://localhost:3106
NOTIFICATION_CENTER_ENABLED=true
JOB_WORKER_CONCURRENCY=5
JOB_LEASE_MS=60000
JOB_HEARTBEAT_MS=20000
JOB_POLL_INTERVAL_MS=5000
JOB_SHUTDOWN_TIMEOUT_MS=30000
JOB_RETENTION_DAYS=90
JOB_CLEANUP_INTERVAL_MS=86400000
JOB_SCHEDULE_INTERVAL_MS=5000
JOB_SCHEDULE_CATCH_UP_LIMIT=100

# URL publik aplikasi: CORS gateway, URL API, dan URL web browser.
CORS_ORIGIN=http://localhost:4200
PUBLIC_API_URL=http://localhost:3000
WEB_APP_URL=http://localhost:4200

# URL service internal: hanya digunakan gateway untuk meneruskan request.
AUTH_SERVICE_URL=http://localhost:3101
USER_SERVICE_URL=http://localhost:3102
LOGS_SERVICE_URL=http://localhost:3103
ACCESS_SERVICE_URL=http://localhost:3104
JOBS_SERVICE_URL=http://localhost:3105
ACCESS_SERVICE_PORT=3104
ACCESS_BOOTSTRAP_ADMIN_EMAILS=admin@local.app
GATEWAY_PERMISSION_CACHE_TTL_MS=60000
GATEWAY_PERMISSION_CACHE_MAX_ENTRIES=1000
ACCESS_PERMISSION_CACHE_TTL_MS=300000
ACCESS_PERMISSION_CACHE_MAX_ENTRIES=1000

# Email lokal: Herd Pro Mail menangkap email di 127.0.0.1:2525 tanpa mengirimkannya.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USERNAME=monobungsia
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# Authentication dan session: secret internal serta kebijakan cookie browser.
INTERNAL_AUTH_SIGNING_SECRET=
AUTH_SESSION_COOKIE_NAME=project_session
AUTH_COOKIE_SECURE=false
AUTH_CLOCK_SKEW_SECONDS=30

# Passkey (WebAuthn): keduanya opsional.
# WEBAUTHN_RP_ID adalah domain tempat passkey terikat; kosong berarti memakai
# host dari WEB_APP_URL. Mengubah domain ini membuat semua passkey lama tidak
# terpakai, jadi biarkan kosong kecuali memang perlu.
# WEBAUTHN_RP_NAME adalah nama yang ditampilkan authenticator saat ceremony.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Monobungsya

# TOTP two factor authentication. Required when ENABLE_INFRASTRUCTURE=true.
# Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Monobungsya

# ERP API untuk MCP server: base URL gateway dan bearer token request ERP.
ERP_URL=http://localhost:3000
ERP_TOKEN=change-me
