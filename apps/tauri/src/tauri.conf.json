{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monobungsia",
  "version": "0.1.0",
  "identifier": "com.ojiepermana.monobungsia",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build:web",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../../../dist/web/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Monobungsia",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["monobungsya"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
