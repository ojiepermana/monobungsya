{
  "ruleVersion": "0014.1",
  "rules": [
    {
      "ruleId": "telemetry.latency.p95",
      "title": "Runtime latency p95",
      "severity": "warning",
      "metric": "telemetry.operation.duration_ns",
      "threshold": 1000,
      "windowSeconds": 300,
      "requiredWindows": 3
    },
    {
      "ruleId": "telemetry.error.rate",
      "title": "Runtime error rate",
      "severity": "critical",
      "metric": "telemetry.operation.count",
      "threshold": 0.05,
      "minimumOperations": 20,
      "windowSeconds": 300,
      "requiredWindows": 3
    },
    {
      "ruleId": "telemetry.drop.total",
      "title": "Telemetry data dropped",
      "severity": "warning",
      "metric": "telemetry.items.dropped_total",
      "threshold": 0,
      "windowSeconds": 300,
      "requiredWindows": 3
    },
    {
      "ruleId": "telemetry.coverage.missing",
      "title": "Missing telemetry buckets",
      "severity": "warning",
      "metric": "telemetry.operation.count",
      "threshold": 0,
      "windowSeconds": 300,
      "requiredWindows": 3
    },
    {
      "ruleId": "telemetry.evaluator.failure",
      "title": "Observability evaluator failure",
      "severity": "critical",
      "metric": "telemetry.errors.total",
      "threshold": 0,
      "minimumOperations": 1,
      "resourceName": "observability.alert.evaluate",
      "windowSeconds": 300,
      "requiredWindows": 3
    },
    {
      "ruleId": "telemetry.memory_pressure.critical",
      "title": "Critical memory pressure",
      "severity": "critical",
      "metric": "telemetry.memory_pressure.critical_total",
      "threshold": 0,
      "windowSeconds": 300,
      "requiredWindows": 3
    }
  ]
}
